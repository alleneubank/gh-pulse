{
  "name": "gh-pulse",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter './packages/*' build && bun run --filter './apps/*' build",
    "typecheck": "tsgo",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "check:version-sync": "bun scripts/check-version-sync.ts",
    "knip": "knip",
    "jscpd": "jscpd .",
    "changeset": "changeset",
    "version": "changeset version && bun scripts/sync-versions.ts",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^24.1.0",
    "@types/picomatch": "^3.0.2",
    "@typescript/native-preview": "^7.0.0-dev.20260120.1",
    "bun-types": "^1.3.6",
    "jscpd": "^4.0.7",
    "knip": "^5.82.1",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "typescript": "^5.9.3",
    "zshy": "^0.7.0"
  }
}
